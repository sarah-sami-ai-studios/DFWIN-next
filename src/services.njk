<section class="page-head">
  <div class="wrap">
    <h1>From a drawing to a delivered order</h1>
    <p class="lede">We engineer the product, find the factory to make it, and bring it to your ship, yard or hotel.</p>
  </div>
</section>

{# The page is a scroll story. With JavaScript and motion allowed, the photo
   stage stays in view and swaps as each step reaches the middle of the screen
   (see assets/js/services.js). Without either, it is a plain three-step list. #}
<section class="on-light band">
<div class="wrap">
  <div class="story" data-story>
    <div class="story__stage" aria-hidden="true">
      {% for c in chapters %}
      <figure class="story__shot{% if c.tile %} story__shot--tile{% endif %}{% if loop.first %} is-active{% endif %}" data-story-shot>
        <img src="{{ c.image | rel }}" alt="" width="{{ c.width }}" height="{{ c.height }}" decoding="async">
      </figure>
      {% endfor %}
    </div>

    <ol class="journey">
      {% for c in chapters %}
      <li class="chapter{% if loop.index % 2 == 0 %} chapter--flip{% endif %}" data-story-chapter>
        <figure class="chapter__photo{% if c.tile %} chapter__photo--tile{% endif %}">
          <img src="{{ c.image | rel }}" alt="{{ c.alt }}" width="{{ c.width }}" height="{{ c.height }}" loading="lazy" decoding="async">
        </figure>
        <div class="chapter__text">
          <span class="chapter__num" aria-hidden="true">{{ loop.index }}</span>
          <h2>{{ c.title }}</h2>
          <p class="chapter__line">{{ c.line }}</p>
          <ul class="chapter__list">
            {% for item in c.list %}<li>{{ item }}</li>
            {% endfor %}
          </ul>
          <p class="chapter__proof">{{ c.proof }}</p>
        </div>
      </li>
      {% endfor %}
    </ol>
  </div>
</div>
</section>
