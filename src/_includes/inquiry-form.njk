<section class="page-head quote-head"><div class="wrap"><h1>{{ inquiryHeading }}</h1><p class="lede">{{ inquiryLead }}</p></div></section>
<div class="on-light band"><div class="wrap" style="max-width:960px;padding-block:2rem 5rem">

<p id="inquiry-intro" style="margin-bottom:1.5rem">{{ inquiryLead }}</p>
<form id="inquiry-form" class="inquiry-form" data-inquiry-type="{{ inquiryType }}">
<div class="form-grid">
<div class="field"><label for="company">Company *</label><input id="company" name="company" maxlength="120" required autocomplete="organization"></div>
<div class="field"><label for="name">Your name *</label><input id="name" name="name" maxlength="120" required autocomplete="name"></div>
<div class="field"><label for="email">Work email *</label><input id="email" name="email" type="email" maxlength="160" required autocomplete="email"></div>
<div class="field"><label for="phone">Phone (optional)</label><input id="phone" name="phone" maxlength="40" autocomplete="tel"></div>
<div class="field span-2"><label for="subject">Subject *</label><input id="subject" name="subject" maxlength="180" required></div>
<div class="field span-2"><label for="message">Tell us what you need *</label><textarea id="message" name="message" rows="6" maxlength="5000" required></textarea></div>
<div class="field product-field" {% if not isProductInquiry %}hidden{% endif %}><label for="quantity">Estimated quantity (optional)</label><input id="quantity" name="quantity" type="number" min="1" max="99999999"></div>
<div class="field product-field" {% if not isProductInquiry %}hidden{% endif %}><label for="targetDate">Target delivery date (optional)</label><input id="targetDate" name="targetDate" type="date"></div>
<div class="field product-field span-2" {% if not isProductInquiry %}hidden{% endif %}><label for="specifications">Materials, dimensions, specifications, target pricing, destination (optional)</label><textarea id="specifications" name="specifications" rows="4" maxlength="4000"></textarea></div>
<div class="hp-field" aria-hidden="true"><label for="website">Leave blank</label><input id="website" name="website" tabindex="-1" autocomplete="off"></div>
</div>
<div class="form-actions"><button class="btn btn--primary" id="inquiry-submit" type="submit">{{ inquiryButton }}</button><p class="quiet">No obligation. We will contact you to discuss next steps.</p></div>
<p id="inquiry-status" role="status" aria-live="polite" style="margin-top:1rem"></p>
</form>
<div id="inquiry-success" hidden tabindex="-1" role="status"><h2>Inquiry received</h2><p id="inquiry-reference"></p><a class="btn btn--outline" href="{{ 'index.html' | rel }}">Return to homepage</a></div>
<div id="inquiry-fallback" hidden><p><strong>We couldn't confirm receipt.</strong> Your information remains in the form. You can send it by email instead.</p><a id="inquiry-email" class="btn btn--outline" href="mailto:{{ site.email.sales }}">Open email draft</a><p class="quiet">If you receive a reference number later, please mention it to avoid duplicate requests.</p></div>
</div></div>
