---
layout: layouts/base.njk
title: Track record
description: Dated record of DFWin contracts, supplier registrations and dry dock work for cruise lines and shipyards since 2014, with the customers who awarded it.
permalink: track-record.html
css: track-record
ctaTitle: Want the same item for your ship or property? Ask for a price.
---
{% set items = news | sort(true, false, "date") %}
{% set years = [] %}
{% for item in items %}{% set y = item.date.slice(0, 4) %}{% if years.indexOf(y) == -1 %}{% set _ = years.push(y) %}{% endif %}{% endfor %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "{{ site.name }} track record",
  "numberOfItems": {{ items.length }},
  "itemListElement": [
    {% for item in items %}{ "@type": "ListItem", "position": {{ loop.index }}, "name": {{ item.title | json | safe }}, "description": {{ item.summary | json | safe }} }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>

<section class="page-head">
  <div class="wrap">
    <h1>Who we supply, and when</h1>
    <p class="lede">Contracts, registrations and dry dock work for cruise lines and shipyards, taken from DFWin's published news.</p>
  </div>
</section>

<div class="on-light band">
<section class="tr-block" aria-labelledby="customers-title">
  <div class="wrap">
    <h2 class="tr-title" id="customers-title">Customers</h2>
    <ul class="tr-logos">
      {% for customer in customers %}
      <li>
        <div class="tr-plate">
          <img src="{{ customer.logo | rel }}" alt="{{ customer.name }}" width="{{ customer.logoWidth }}" height="{{ customer.logoHeight }}" loading="lazy" decoding="async">
        </div>
        <p class="tr-logos__note">{{ customer.note }}</p>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="tr-block" aria-labelledby="timeline-title">
  <div class="wrap">
    <h2 class="tr-title" id="timeline-title">Timeline</h2>
    {% for y in years %}
    <div class="tr-year">
      <h3 class="tr-year__num">{{ y }}</h3>
      <ol class="tr-list">
        {% for item in items %}{% if item.date.slice(0, 4) == y %}
        <li class="tr-row">
          <p class="tr-row__date data">{% if item.approximateDate %}{{ y }}{% else %}<time datetime="{{ item.date | isoDate }}">{{ item.date | longDate }}</time>{% endif %}</p>
          <div>
            <h4 class="tr-row__title">{{ item.title }}</h4>
            {% if item.customer %}<p class="tr-row__customer">{{ item.customer }}</p>{% endif %}
          </div>
        </li>
        {% endif %}{% endfor %}
      </ol>
    </div>
    {% endfor %}
  </div>
</section>

<section class="tr-block tr-block--last" aria-labelledby="reg-title">
  <div class="wrap">
    <h2 class="visually-hidden" id="reg-title">Registrations and sponsorships</h2>
    <ul class="tr-tags">
      <li class="tag">Registered supplier: Carnival, Royal Caribbean, Norwegian Cruise Line</li>
      <li class="tag">Registered supplier: Meyer Group</li>
      <li class="tag">Silver Sponsor: MHA Conference 2026</li>
      <li class="tag">Sponsor: CLIA Cruise Week Europe 2025</li>
    </ul>
  </div>
</section>

{% if testimonials.length %}
<section class="tr-block tr-block--last" aria-labelledby="quotes-title">
  <div class="wrap">
    <h2 class="visually-hidden" id="quotes-title">What customers say</h2>
    <div class="tr-quotes">
      {% for t in testimonials %}
      <figure class="quote">
        <blockquote><p>{{ t.quote }}</p></blockquote>
        <figcaption><strong>{{ t.name }}</strong><span>{{ t.role }}{% if t.role and t.company %}, {% endif %}{{ t.company }}</span></figcaption>
      </figure>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
</div>
