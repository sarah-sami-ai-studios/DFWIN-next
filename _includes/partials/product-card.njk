{# One catalog product. Expects a `product` variable from src/_data/products.json #}
<article class="product-card" data-product data-id="{{ product.id }}" data-sector="{{ product.sector }}" data-category="{{ product.category }}" data-search="{{ (product.name + ' ' + product.id + ' ' + product.sector + ' ' + product.category + ' ' + (product.keywords | join(' '))) | lower }}">
  <a class="product-card__photo" href="{{ ('products/' + product.slug + '.html') | rel }}" tabindex="-1" aria-hidden="true">
    <img src="{{ product.image | rel }}" alt="" width="480" height="480" loading="lazy" decoding="async">
  </a>
  <div class="product-card__body">
    <p class="product-card__meta">{{ product.sector }} / {{ product.category }}</p>
    <h3 class="product-card__name"><a href="{{ ('products/' + product.slug + '.html') | rel }}">{{ product.name }}</a></h3>
  </div>
  <div class="product-card__add">
    <button class="btn btn--add" type="button" data-quote-add="{{ product.id }}" data-name="{{ product.name }}" aria-pressed="false">Add to quote list</button>
  </div>
</article>
