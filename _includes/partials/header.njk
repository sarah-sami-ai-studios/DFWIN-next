{# Site header. Navigation items come from src/_data/nav.json #}
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="{{ 'index.html' | rel }}" aria-label="{{ site.name }} home">
      <img src="{{ 'assets/img/logo-dfwin.png' | rel }}" alt="{{ site.shortName }}" width="520" height="203">
    </a>
    <nav class="site-nav" id="site-nav" aria-label="Main">
      {% for item in nav.main %}
      <a href="{{ item.url | rel }}"{% if page.url == '/' + item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </nav>
    <div class="header-actions">
      <form class="site-search" action="{{ 'catalog.html' | rel }}" method="get" role="search" data-site-search>
        <label class="visually-hidden" for="site-search-q">Search the catalog</label>
        <input class="site-search__input" type="search" id="site-search-q" name="q" placeholder="Search products" autocomplete="off" enterkeyhint="search" tabindex="-1">
        <button class="site-search__toggle" type="button" aria-label="Search the catalog" aria-expanded="false" aria-controls="site-search-q" data-site-search-toggle>{% icon "magnifying-glass" %}</button>
      </form>
      <a class="btn btn--primary btn--small" href="{{ 'quote.html' | rel }}">
        <span>Request a quote</span>
        <span class="quote-count" data-quote-count hidden>0</span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
        {% icon "list" %}<span class="visually-hidden">Menu</span>
      </button>
    </div>
  </div>
</header>
